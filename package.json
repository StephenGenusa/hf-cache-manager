{
  "name": "hf-cache-manager",
  "version": "1.0.1",
  "description": "A desktop manager for the local Hugging Face model cache: see what is on disk, get keep-or-delete advice for your PC, reclaim space safely and download exactly the files you need.",
  "keywords": [
    "huggingface",
    "hugging-face",
    "model-cache",
    "gguf",
    "llm",
    "lm-studio",
    "ollama",
    "electron",
    "disk-space"
  ],
  "author": "Stephen Genusa",
  "license": "MIT",
  "homepage": "https://github.com/StephenGenusa/hf-cache-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/StephenGenusa/hf-cache-manager.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "clsx": "2.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "main": "out/main/index.js",
  "desktopName": "hf-cache-manager.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "knowledge": "node scripts/knowledge/print.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "pree2e": "npm run build",
    "e2e": "playwright test",
    "test:property:random": "FC_SEED=random vitest run tests/core/property",
    "icon": "electron scripts/make-icon.mjs",
    "screenshots": "npm run build && playwright test -c playwright.screenshots.config.ts",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac dir && scripts/build/zip-mac.sh"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
