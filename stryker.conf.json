{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/plan/planner.ts",
    "src/core/plan/closure.ts",
    "src/core/plan/freed.ts",
    "src/core/exec/executor.ts",
    "src/core/exec/store-ops.ts",
    "src/core/safe-fs.ts",
    "src/core/hold/manifest.ts",
    "src/core/hold/view-limits.ts",
    "src/core/hold/held.ts",
    "src/core/hold/tree.ts",
    "src/core/sync/sync.ts",
    "src/core/views/impact.ts",
    "src/core/views/lmstudio.ts",
    "src/core/views/ollama.ts",
    "src/core/views/ollama-create.ts",
    "src/core/views/walk.ts",
    "src/core/compat/state.ts",
    "src/core/views/reconcile.ts",
    "src/core/views/view-path.ts",
    "src/core/advice/engine.ts",
    "src/core/advice/shape.ts",
    "src/shared/knowledge/name-parts.ts",
    "src/core/download/download-fs.ts",
    "src/core/download/cache-state.ts",
    "src/main/hub/policy.ts"
  ],
  "thresholds": { "high": 95, "low": 90, "break": 85 },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["dist", "private", "test-results", "coverage"],
  "concurrency": 8,
  "incremental": true,
  "ignoreStatic": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
